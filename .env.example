# ── LLM Provider Keys ────────────────────────────────────────────────────────
# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenRouter — gives access to GPT-4o, Claude, Mistral, etc.
# (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# ── Local Ollama (optional) ───────────────────────────────────────────────────
# Base URL for a locally running Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# ── Encryption ────────────────────────────────────────────────────────────────
# Fernet key used to encrypt external DB passwords stored on disk.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── Workspace Storage ─────────────────────────────────────────────────────────
# Root directory where per-workspace data (SQLite DBs, catalogs) are stored.
# Defaults to ./workspaces if not set.
WORKSPACE_ROOT=workspaces

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Use * for development.
CORS_ALLOWED_ORIGINS=*

# ── Query Limits ─────────────────────────────────────────────────────────────
# Maximum rows returned from a single SQL query
MAX_SQL_ROWS=500

# Maximum CSV file size in megabytes that can be uploaded
MAX_CSV_SIZE_MB=100

# Maximum rows to read from a CSV file (blank = no limit)
MAX_CSV_ROWS=

# Chunk size for chunked CSV ingestion (rows per chunk)
CHUNK_SIZE=50000

# File size threshold in MB above which chunked ingestion is used
CHUNK_THRESHOLD_MB=50

# ── Default LLM Provider ─────────────────────────────────────────────────────
# Used when no provider is specified in the request
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.0-flash
